# Copy to secrets.yaml and fill in real values.
# secrets.yaml is gitignored and must never be committed.
#
# ON THE CLUSTER, DO NOT MAINTAIN THIS FILE BY HAND. It is generated into the
# pod at startup from the `ha-secrets` Sealed Secret by the sync-config
# initContainer. Editing /config/secrets.yaml inside the running pod works
# until the next restart, then gets overwritten.
#
# To change a secret for real: update the Sealed Secret and commit it.
# See docs/disaster-recovery.md § Secrets.
#
# This file remains the template for the local docker-compose escape hatch, and
# the canonical list of which keys must exist.

# ── Location and identity ────────────────────────────────────────────────────
home_name: "My Home"
home_latitude: 0.0
home_longitude: 0.0
home_elevation: 0

# Must be a real tzdata zone. `Etc/` contains only UTC, GMT and GMT±N —
# `Etc/Stockholm` is not a zone and silently resolves to UTC.
home_timezone: "Europe/Stockholm"

# ── Recorder database ────────────────────────────────────────────────────────
# SQLite — a single file inside /config. Single-writer home install, no
# separate database container to run/patch/back up, and the recorder DB
# rides along with the rest of /config for backup purposes instead of needing
# its own dump/restore pipeline. See docs/MIGRATION.md § Decisions for the
# history (this superseded an earlier Postgres-from-day-one decision, made
# back when the config directory was a restart-prone MicroK8s hostPath PVC;
# that risk doesn't apply to a stable Podman bind mount).
#
# scripts/backup.sh takes a consistent snapshot via SQLite's VACUUM INTO
# before backing it up — never sync/copy this file directly while Home
# Assistant is running, a live WAL-mode SQLite file copied mid-write is torn
# and unrestorable.
recorder_db_url: "sqlite:////config/home-assistant_v2.db"

# ── Monitoring ───────────────────────────────────────────────────────────────
# Long-lived access token used by Grafana Alloy to scrape /api/prometheus.
# Create it in the Home Assistant UI: click your user (bottom left) → Security
# tab → scroll to the bottom → Create Token.
#
# Home Assistant itself does not read this key — it lives here so the full set
# of credentials is documented in one place. The value Alloy actually uses comes
# from the `grafana-cloud` Sealed Secret. See docs/grafana-cloud.md.
prometheus_token: "CHANGEME"
