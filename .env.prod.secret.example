# Copy to .env.prod.secret on the server and fill in real values.
# .env.prod.secret is gitignored and must never be committed — it replaces
# the Sealed Secrets (grafana-cloud, restic) from the MicroK8s setup. See
# docs/podman-deploy.md.
#
# chmod 600 this file once it has real values in it.
#
# The recorder database is SQLite (see config/secrets.yaml.example), not
# Postgres, so there are no database credentials in this file.

# ── Grafana Cloud (docs/grafana-cloud.md § Credentials) — OPTIONAL, NOT YET WIRED
# Alloy has not been ported to Podman (see docs/podman-deploy.md § Known
# gaps) — no podman/*.container unit reads these keys yet. Leave them as
# CHANGEME; they do nothing until Alloy is ported. Once it is, GC_HA_TOKEN is
# a Home Assistant long-lived access token (create it in the HA UI: user icon
# -> Security -> Long-lived access tokens).
GC_PROM_URL=CHANGEME
GC_PROM_USER=CHANGEME
GC_LOKI_URL=CHANGEME
GC_LOKI_USER=CHANGEME
GC_TOKEN=CHANGEME
GC_HA_TOKEN=CHANGEME

# ── restic backup — OPTIONAL FOR FIRST DEPLOY ─────────────────────────────────
# podman/backup.service + backup.timer are real and installed by
# bootstrap-podman.sh, but the timer is NOT auto-enabled. Leave these as
# CHANGEME until you're ready to configure backups — see
# docs/disaster-recovery.md. Enabling backup.timer with placeholder values
# here makes it fail every night at 03:15.
RESTIC_REPOSITORY=CHANGEME
RESTIC_PASSWORD=CHANGEME
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME
