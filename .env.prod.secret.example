# Copy to .env.prod.secret on the server and fill in real values.
# .env.prod.secret is gitignored and must never be committed — it replaces
# the Sealed Secrets (postgres-credentials, grafana-cloud, restic) from the
# MicroK8s setup. See docs/podman-deploy.md.
#
# chmod 600 this file once it has real values in it.
#
# PG_USER / PG_PASS here MUST match the credentials embedded in
# config/secrets.yaml's recorder_db_url — nothing checks that automatically,
# same caveat the Sealed Secret version had.

# ── Postgres (podman/postgres.container) ─────────────────────────────────────
POSTGRES_USER=ha
POSTGRES_PASSWORD=CHANGEME

# ── Grafana Cloud (docs/grafana-cloud.md § Credentials) ──────────────────────
# Used by Alloy. GC_HA_TOKEN is a Home Assistant long-lived access token
# (create it in the HA UI: user icon -> Security -> Long-lived access tokens).
GC_PROM_URL=CHANGEME
GC_PROM_USER=CHANGEME
GC_LOKI_URL=CHANGEME
GC_LOKI_USER=CHANGEME
GC_TOKEN=CHANGEME
GC_HA_TOKEN=CHANGEME

# ── restic backup ─────────────────────────────────────────────────────────────
RESTIC_REPOSITORY=CHANGEME
RESTIC_PASSWORD=CHANGEME
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME
