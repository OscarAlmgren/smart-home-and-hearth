        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "homeassistant_light_brightness_percent{entity!~\".*kajplats.*\"}",
          "legendFormat": "{{friendly_name}}",
          "instant": true,
          "range": false
