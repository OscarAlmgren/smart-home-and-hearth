    {
      "id": 14,
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "type": "stat",
      "title": "Thread border router",
      "description": "The two alarm sensors from packages/thread_watchdog.yaml: router not answering, or Thread radio disabled. Matter-over-Thread devices go unavailable when this is red.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(homeassistant_binary_sensor_state{entity=~\"binary_sensor.thread_(border_router_down|radio_disabled)\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "PROBLEM",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
