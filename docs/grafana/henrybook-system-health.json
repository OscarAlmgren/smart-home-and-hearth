        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "type": "timeseries",
      "title": "Load average",
      "description": "Two cores: a load above 2 means work is queueing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
