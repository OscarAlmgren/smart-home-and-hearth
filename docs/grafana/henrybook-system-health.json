        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "type": "stat",
      "title": "Henrybook uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - node_boot_time_seconds{instance=\"henrybook\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
