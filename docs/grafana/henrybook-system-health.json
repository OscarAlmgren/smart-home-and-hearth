      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#EAB839",
                "value": null
