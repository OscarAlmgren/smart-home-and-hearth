# Recorder database for Home Assistant. Port of
# k8s/base/postgres/statefulset.yaml — see that file's history for why the
# tuning values are what they are (flash-wear and low-RAM constrained).
#
# Install: symlink or copy into /etc/containers/systemd/ (system-wide, root
# Podman — matches the privileged/host-network posture homeassistant.container
# already needs). systemd-generator turns this into postgres.service on the
# next `systemctl daemon-reload`. See docs/podman-deploy.md.
[Unit]
Description=Postgres (Home Assistant recorder database)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=postgres

# Not on the host network — nothing outside this host needs to reach it.
# Published to loopback only so the host-networked homeassistant container
# (which shares the host's 127.0.0.1) can still connect.
PublishPort=127.0.0.1:5432:5432

Environment=POSTGRES_DB=homeassistant
# POSTGRES_USER / POSTGRES_PASSWORD come from EnvironmentFile. Must match the
# credentials embedded in config/secrets.yaml's recorder_db_url — nothing
# checks that automatically, same caveat as the Sealed Secret version had.
EnvironmentFile=/opt/smart-home-and-hearth/.env.prod.secret
# The image refuses to initialise into a non-empty directory, and a bind
# mount's root can pick up filesystem cruft — keep the cluster in a
# subdirectory rather than at the mount root.
Environment=PGDATA=/var/lib/postgresql/data/pgdata

Volume=/var/lib/smart-home-and-hearth/postgres:/var/lib/postgresql/data

# Tuned small deliberately — this node has ~4.8 GiB shared with everything
# else. Flash wear: fewer, larger checkpoints beat constant small writes. WAL
# is capped so a burst cannot fill the disk and wedge the database.
Exec=postgres -c shared_buffers=64MB -c effective_cache_size=256MB -c max_connections=20 -c work_mem=4MB -c maintenance_work_mem=32MB -c checkpoint_timeout=15min -c checkpoint_completion_target=0.9 -c max_wal_size=256MB -c min_wal_size=64MB

# sh -c so $POSTGRES_USER/$POSTGRES_DB expand — HealthCmd runs via /bin/sh -c,
# but a bare `pg_isready -U $POSTGRES_USER` without quoting would still break
# if the value ever contains a space.
HealthCmd=/bin/sh -c 'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=30s

# No CPU limit — same reasoning as Home Assistant: 2 slow cores, and
# throttling the database throttles the whole install.
PodmanArgs=--memory=384m

[Service]
# Matches the retry/backoff shape the Argo CD Application already used
# (limit 5, then stop trying) rather than restarting forever — see the Aug 6
# incident notes. If it fails 5 times in 10 minutes, stop and require a human.
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target default.target
