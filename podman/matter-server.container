# python-matter-server — the project backing Home Assistant's Matter
# integration. Needed as a standalone container because HA's own Matter
# Server add-on only exists under HAOS's supervisor.
#
# Talks to HA over websocket (ws://127.0.0.1:5580/ws — add the Matter
# integration in the HA UI once this is up) and reaches Thread devices via a
# Thread Border Router discovered over mDNS: today the Google/Nest Wifi
# border routers, and once it is deployed, the on-host OTBR container with
# the Sonoff dongle as its radio (docs/hardware.md § Radios). Commissioning
# currently happens from a phone's own BLE, which hands the device off onto
# the Thread mesh. The host has had a USB Bluetooth adapter since 2026-09-15,
# but it is only wired into Home Assistant, not into this container.
#
# Install: copy into /etc/containers/systemd/. See docs/podman-deploy.md.
[Unit]
Description=Matter Server (Matter/Thread device commissioning for Home Assistant)
After=network-online.target
Wants=network-online.target

# StartLimitIntervalSec/StartLimitBurst only take effect in [Unit] — systemd
# silently ignores them in [Service] ("Unknown key ... ignoring"), which is
# where they used to live here. See homeassistant.container for the full
# explanation (Aug 25 incident notes in docs/disaster-recovery.md).
StartLimitIntervalSec=600
StartLimitBurst=10

[Container]
Image=ghcr.io/home-assistant-libs/python-matter-server:stable
ContainerName=matter-server

# Host networking so HA (also host-networked) can reach the websocket at
# 127.0.0.1, and so mDNS discovery of the Thread border agent works the same
# way it does for other LAN discovery (Chromecast, HomeKit, etc — see the
# host-networking rationale in homeassistant.container).
Network=host

Volume=/var/lib/smart-home-and-hearth/matter-server:/data

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
