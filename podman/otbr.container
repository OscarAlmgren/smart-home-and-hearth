# OpenThread Border Router — containerized, since HA's OTBR add-on is only
# available under HAOS's supervisor, not a bare Podman/HA install.
#
# This is the same Sonoff dongle originally bought for Zigbee, reflashed with
# OpenThread RCP firmware — Thread/Matter is being brought up first, Zigbee
# deferred until a separate dongle is available (see docs/hardware.md § Radios,
# CLAUDE.md § Deferred work). Concurrent Zigbee+Thread on one radio needs
# Silicon Labs multiprotocol firmware, which upstream has deprecated — so this
# dongle is Thread-only now, not shared.
#
# Install: copy into /etc/containers/systemd/, same as the other units here.
# See docs/podman-deploy.md.
[Unit]
Description=OpenThread Border Router (Thread/Matter radio)
After=network-online.target
Wants=network-online.target

# StartLimitIntervalSec/StartLimitBurst only take effect in [Unit] — systemd
# silently ignores them in [Service] ("Unknown key ... ignoring"), which is
# where they used to live here. Without them actually applying,
# Restart=on-failure had no real cap: a broken container (this exact unit hit
# this — see the Aug 25 incident notes in docs/disaster-recovery.md) restarts
# indefinitely, filling the journal/disk over a long outage. Burst is set
# above systemd's default of 5 because a legitimate cold start (image pull +
# extract on henrybook's hardware) can itself take a few minutes and
# shouldn't be mistaken for crash-looping.
StartLimitIntervalSec=600
StartLimitBurst=10

[Container]
Image=docker.io/openthread/otbr:latest
ContainerName=otbr

# host networking + privileged: OTBR manipulates the host's IPv6 routing
# table, runs its own mDNS/SRP responder, and needs raw netlink access for
# NAT66/backbone routing onto the LAN — same class of reason
# homeassistant.container already runs privileged/host-network. There's only
# one physical NIC on this box (enp3s0, see docs/hardware.md), so that's the
# backbone/infra interface below.
Network=host
PodmanArgs=--privileged

# The by-id string is derived from the dongle's onboard CP2102N USB-UART
# bridge, not the EFR32's application firmware — reflashing the radio from
# Zigbee EmberZNet to OpenThread RCP does NOT change it. Confirmed on
# henrybook: still usb-ITEAD_SONOFF_Zigbee_3.0_USB_Dongle_Plus_V2_<serial>-if00
# (no "-port0" suffix on this dongle, unlike the placeholder that used to be
# here). Re-run `ls -l /dev/serial/by-id/` only if the dongle itself changes.
# Baud rate depends on the exact RCP firmware build flashed — check its docs
# if the default below doesn't associate.
AddDevice=/dev/serial/by-id/usb-ITEAD_SONOFF_Zigbee_3.0_USB_Dongle_Plus_V2_20240124154748-if00:/dev/ttyOTBR

# Recommended by the upstream Docker guide (https://openthread.io/guides/border-router/docker):
# lets the container's own DNS/SRP responder resolve Thread hostnames.
DNS=127.0.0.1
# NOTE (2026-08-25): Sysctl= lines used to be set here for disable_ipv6=0 and
# ipv4/ipv6 forwarding=1, but podman 5.7.0 rejects per-container sysctls under
# Network=host ("can't be set since Network Namespace set to host: invalid
# argument") — with host networking the container IS the host netns, so these
# have to be host-level settings instead. See scripts/bootstrap-podman.sh,
# which now applies /etc/sysctl.d/99-otbr-forwarding.conf and loads the
# iptable_nat/iptable_mangle/iptable_filter/ip6table_filter kernel modules
# OTBR's own entrypoint needs for its NAT44 setup (also not optional — it
# `die`s without them). See docs/podman-deploy.md § Host prerequisites.

# Persists the Thread network dataset (keys, PAN ID, channel) across
# container recreation — losing this means re-forming the Thread network and
# re-joining every device, the Thread equivalent of zigbee.db.
Volume=/var/lib/smart-home-and-hearth/otbr:/var/lib/thread

# -B <infra-if> is the backbone/infra interface (the LAN NIC). Verify the
# port OTBR's REST API listens on for your image tag before relying on this
# healthcheck — it has moved across OTBR releases.
Exec=--radio-url spinel+hdlc+uart:///dev/ttyOTBR?uart-baudrate=460800 -B enp3s0

HealthCmd=wget --quiet --tries=1 --spider http://localhost:8081/node/state || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=60s
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
